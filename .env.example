# Application
NODE_ENV=development
APP_NAME=Express Postgres Boilerplate
APP_VERSION=2.0.0
HOST=0.0.0.0
PORT=4300
PUBLIC_URL=http://localhost:4300
API_PREFIX=/api/v1
WEB_APP_URL=http://localhost:5173
TRUST_PROXY=false
JSON_BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000

# PostgreSQL / Drizzle
DATABASE_URL=postgresql://boilerplate:boilerplate@localhost:5432/boilerplate
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Authentication
# Generate a real secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=development-only-access-secret-change-me-please
JWT_ACCESS_TTL=15m
REFRESH_SESSION_TTL=7d
REFRESH_REUSE_GRACE=5s
ACCESS_TOKEN_ROTATION_GRACE=30s
AUTH_CLEANUP_INTERVAL=1h
AUTH_EMAIL_REQUEST_COOLDOWN=20m
AUTH_EMAIL_WORKER_POLL_INTERVAL=1s
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
JWT_ISSUER=express-postgres-boilerplate
JWT_AUDIENCE=express-postgres-boilerplate-client
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=strict
REFRESH_COOKIE_DOMAIN=

# Browser access
CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=600

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=100
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REFRESH_MAX=50
RATE_LIMIT_PUBLIC_AUTH_MAX=10
RATE_LIMIT_MONITORING_MAX=300
RATE_LIMIT_EMAIL_RESEND_WINDOW_MS=3600000
RATE_LIMIT_EMAIL_RESEND_IP_MAX=3
RATE_LIMIT_EMAIL_RESEND_RECIPIENT_MAX=1

# Logging and monitoring
LOG_LEVEL=debug
LOG_PRETTY=true
LOG_SILENT=false
METRICS_ENABLED=true
# Generate a separate token with: openssl rand -base64 48
METRICS_BEARER_TOKEN=development-only-metrics-token-change-me-please
READINESS_TIMEOUT_MS=2000
READINESS_CACHE_TTL_MS=1000
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_TOKEN=

# API reference
API_DOCS_ENABLED=true
API_DOCS_PATH=/docs

# Email (Mailpit runs on SMTP 1025 and UI 8025 in compose.yaml)
MAIL_TRANSPORT=smtp
MAIL_FROM=Express Boilerplate <noreply@example.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=5000
SMTP_USER=
SMTP_PASSWORD=

# Optional admin seed used by `pnpm seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Boilerplate Admin
SEED_ADMIN_PASSWORD=Change-this-development-password-7!
