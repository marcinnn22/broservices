NODE_ENV=test
APP_NAME=Express Postgres Boilerplate Test
APP_VERSION=2.0.0-test
HOST=127.0.0.1
PORT=4301
PUBLIC_URL=http://localhost:4301
API_PREFIX=/api/v1
WEB_APP_URL=http://localhost:5173
DATABASE_URL=postgresql://boilerplate:boilerplate@localhost:5433/boilerplate_test
DATABASE_POOL_MAX=2
JWT_ACCESS_SECRET=test-access-secret-that-is-longer-than-thirty-two-characters
JWT_ACCESS_TTL=15m
REFRESH_SESSION_TTL=7d
REFRESH_REUSE_GRACE=5s
ACCESS_TOKEN_ROTATION_GRACE=30s
AUTH_CLEANUP_INTERVAL=1h
AUTH_EMAIL_REQUEST_COOLDOWN=20m
AUTH_EMAIL_WORKER_POLL_INTERVAL=1s
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h
ARGON2_MEMORY_COST_KIB=8192
ARGON2_TIME_COST=1
ARGON2_PARALLELISM=1
CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=true
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_LOGIN_MAX=1000
RATE_LIMIT_REFRESH_MAX=1000
RATE_LIMIT_PUBLIC_AUTH_MAX=1000
RATE_LIMIT_MONITORING_MAX=1000
RATE_LIMIT_EMAIL_RESEND_IP_MAX=100
RATE_LIMIT_EMAIL_RESEND_RECIPIENT_MAX=100
LOG_LEVEL=error
LOG_PRETTY=false
LOG_SILENT=true
MAIL_TRANSPORT=log
MAIL_FROM=Test <test@example.com>
API_DOCS_ENABLED=true
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=test-metrics-token-that-is-longer-than-thirty-two-characters
READINESS_CACHE_TTL_MS=1000
ALERT_WEBHOOK_ENABLED=false
